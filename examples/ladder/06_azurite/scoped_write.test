# name: scoped_write.test
# description: Writes and reads under its own place on the local Azure blob server, with the connection string set for it.
# group: [ladder]

# -----------------------------------------------------------------------------
# The connection string is a setting, not a secret
#

query II
SELECT current_setting('azure_storage_connection_string') <> '', count(*) FROM duckdb_secrets()
----
true	0

# -----------------------------------------------------------------------------
# A write and a read under the test's own place
#

statement ok
COPY (SELECT 42 AS answer) TO '{TEMP_DIR}/answer.csv'

query I
SELECT answer FROM read_csv('{TEMP_DIR}/answer.csv')
----
42
