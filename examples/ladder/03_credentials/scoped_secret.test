# name: scoped_secret.test
# description: The init file creates the secret from a template; the binary fills in the values.
# group: [ladder]

# -----------------------------------------------------------------------------
# One secret under auth=key, scoped to the storage; none under auth=none
#

query I
SELECT count(*) FROM duckdb_secrets()
WHERE name = 'ducktest_fake_s3' AND type = 's3' AND scope = ['s3://ladder-fake']
----
{SCOPED_ROWS}

query I
SELECT count(*) FROM duckdb_secrets()
